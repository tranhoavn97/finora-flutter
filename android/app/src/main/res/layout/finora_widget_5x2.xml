<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/finora_widget_bg_glass_frost"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Frosted Glass Header with Crisp Finora Mascot -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Hero Mascot Halo (42dp circle, crisp 38dp 3D cat mascot) -->
        <FrameLayout
            android:id="@+id/widget_mascot_wrap"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/finora_widget_mascot_halo_dark"
            android:padding="2dp">

            <ImageView
                android:id="@+id/widget_mascot_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Linh thú FINORA"
                android:scaleType="fitCenter"
                android:src="@drawable/finora_widget_mascot_happy" />
        </FrameLayout>

        <!-- Fallback app icon if mascot is hidden -->
        <ImageView
            android:id="@+id/widget_brand_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="FINORA"
            android:src="@mipmap/ic_launcher_round"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_brand_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="FINORA"
                android:textColor="#FFFFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_sync_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Linh thú đang theo dõi • Trực tiếp"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_actions_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_btn_refresh"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/finora_widget_pill_glass"
                android:contentDescription="Làm mới"
                android:padding="6.5dp"
                android:src="@drawable/ic_widget_refresh" />

            <LinearLayout
                android:id="@+id/widget_btn_quick_add"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/finora_widget_pill_primary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="Ghi nhanh"
                    android:src="@drawable/ic_widget_plus" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:includeFontPadding="false"
                    android:text="Ghi"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Two Frosted Glass Bento Tiles: Spending + Pending Bank Queue -->
    <LinearLayout
        android:id="@+id/widget_bento_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="9dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Glass Tile: Direct Spending & Balance -->
        <LinearLayout
            android:id="@+id/widget_spend_tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1.05"
            android:background="@drawable/finora_widget_tile_glass_dark"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="11dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_spend_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="Chi tiêu"
                    android:src="@drawable/ic_widget_wallet" />

                <TextView
                    android:id="@+id/widget_spend_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="CHI HÔM NAY"
                    android:textColor="#94A3B8"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_today_expense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0 đ"
                android:textColor="#FB7185"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_month_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Tháng: 0 đ • Ví: 0 đ"
                android:textColor="#CBD5E1"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Right Glass Tile: Pending Bank Balance Notifications -->
        <LinearLayout
            android:id="@+id/widget_pending_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1.15"
            android:background="@drawable/finora_widget_emerald_card_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="11dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_pending_bell"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="Số dư chờ"
                    android:src="@drawable/ic_widget_bell"
                    android:tint="#34D399" />

                <TextView
                    android:id="@+id/widget_pending_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="CẦN GHI CHÉP"
                    android:textColor="#34D399"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_pending_badge_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/finora_widget_pill_emerald"
                    android:includeFontPadding="false"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:text="Đã ghi đủ"
                    android:textColor="#D1FAE5"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_pending_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Không có biến động chờ"
                android:textColor="#FFFFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_pending_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="Chạm để mở hộp thư số dư →"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
