<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/finora_widget_bg_glass_frost"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Frosted Glass Hero Header with Prominent Crisp Mascot & Speech Pill -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_mascot_wrap"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/finora_widget_mascot_halo_dark"
            android:padding="2.5dp">

            <ImageView
                android:id="@+id/widget_mascot_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Linh thú FINORA"
                android:scaleType="fitCenter"
                android:src="@drawable/finora_widget_mascot_happy" />
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_brand_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="FINORA"
            android:src="@mipmap/ic_launcher_round"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_brand_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="FINORA"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_sync_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="• Trực tiếp"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_mascot_speech_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/finora_widget_speech_dark"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="Tuyệt vời! Sổ sách đã gọn ✓"
                android:textColor="#E2E8F0"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_actions_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_btn_refresh"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/finora_widget_pill_glass"
                android:contentDescription="Làm mới"
                android:padding="6.5dp"
                android:src="@drawable/ic_widget_refresh" />

            <LinearLayout
                android:id="@+id/widget_btn_quick_add"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/finora_widget_pill_primary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="Ghi nhanh"
                    android:src="@drawable/ic_widget_plus" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:includeFontPadding="false"
                    android:text="Ghi"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Top 3 Frosted Glass KPI Strip -->
    <LinearLayout
        android:id="@+id/widget_kpi_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_kpi_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/finora_widget_tile_glass_dark"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/widget_kpi_today_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="CHI HÔM NAY"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_today_expense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0 đ"
                android:textColor="#FB7185"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_today_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0 giao dịch"
                android:textColor="#CBD5E1"
                android:textSize="9.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_kpi_month"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/finora_widget_tile_glass_dark"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/widget_kpi_month_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="THÁNG NÀY"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_month_expense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0 đ"
                android:textColor="#F8FAFC"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_month_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Thu: 0 đ"
                android:textColor="#34D399"
                android:textSize="9.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_kpi_balance"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/finora_widget_tile_glass_dark"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/widget_kpi_balance_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="TỔNG SỐ DƯ"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_total_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0 đ"
                android:textColor="#34D399"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_balance_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Ví &amp; Ngân hàng"
                android:textColor="#CBD5E1"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Middle Section: Pending Bank Notifications ("Số dư cần ghi chép") -->
    <LinearLayout
        android:id="@+id/widget_pending_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:background="@drawable/finora_widget_emerald_card_bg"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingTop="8dp"
        android:paddingEnd="11dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_pending_bell"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="Số dư cần ghi chép"
                android:src="@drawable/ic_widget_bell"
                android:tint="#34D399" />

            <TextView
                android:id="@+id/widget_pending_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="SỐ DƯ CẦN GHI CHÉP"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_pending_badge_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/finora_widget_pill_emerald"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="2.5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2.5dp"
                android:text="Đã ghi đủ"
                android:textColor="#D1FAE5"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_pending_arrow"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Mở"
                android:src="@drawable/ic_widget_arrow_right" />
        </LinearLayout>

        <!-- Pending row 1 -->
        <LinearLayout
            android:id="@+id/widget_pending_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_pending_row_1_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="Dot"
                android:src="@drawable/finora_widget_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_pending_row_1_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="NCB • Biến động"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_pending_row_1_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Nội dung biến động"
                    android:textColor="#CBD5E1"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_pending_row_1_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="+1.000.000 đ"
                    android:textColor="#34D399"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_pending_row_1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:text="00:04"
                    android:textColor="#94A3B8"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Pending row 2 -->
        <LinearLayout
            android:id="@+id/widget_pending_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_pending_row_2_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="Dot"
                android:src="@drawable/finora_widget_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_pending_row_2_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Vietcombank"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_pending_row_2_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Nội dung"
                    android:textColor="#CBD5E1"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_pending_row_2_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="-150.000 đ"
                    android:textColor="#FB7185"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_pending_row_2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:text="11:20"
                    android:textColor="#94A3B8"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_pending_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="Mọi biến động số dư đã được ghi chép đầy đủ. Chạm để mở hộp thư số dư."
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_pending_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="+1 biến động khác đang chờ →"
            android:textColor="#FCD34D"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom Section: Recent Transactions ("Chi tiêu gần đây") -->
    <LinearLayout
        android:id="@+id/widget_recent_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="9dp"
        android:layout_weight="1"
        android:background="@drawable/finora_widget_tile_glass_dark"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingTop="8dp"
        android:paddingEnd="11dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_recent_header_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="CHI TIÊU GẦN ĐÂY"
                android:textColor="#94A3B8"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_recent_open_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Mở sổ →"
                android:textColor="#34D399"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Recent row 1 -->
        <LinearLayout
            android:id="@+id/widget_recent_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_recent_1_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="Loại"
                android:src="@drawable/finora_widget_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_recent_1_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Ăn uống"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_recent_1_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Ví tiền • Hôm nay"
                    android:textColor="#94A3B8"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_recent_1_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:includeFontPadding="false"
                android:text="-55.000 đ"
                android:textColor="#FB7185"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Recent row 2 -->
        <LinearLayout
            android:id="@+id/widget_recent_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_recent_2_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="Loại"
                android:src="@drawable/finora_widget_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_recent_2_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Di chuyển"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_recent_2_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Vietcombank"
                    android:textColor="#94A3B8"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_recent_2_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:includeFontPadding="false"
                android:text="-120.000 đ"
                android:textColor="#FB7185"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Recent row 3 -->
        <LinearLayout
            android:id="@+id/widget_recent_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_recent_3_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="Loại"
                android:src="@drawable/finora_widget_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_recent_3_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Lương / Thu"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_recent_3_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="MB Bank"
                    android:textColor="#94A3B8"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_recent_3_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:includeFontPadding="false"
                android:text="+2.000.000 đ"
                android:textColor="#34D399"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_recent_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:text="Mở FINORA hoặc chạm + Ghi để đồng bộ giao dịch gần đây."
            android:textColor="#CBD5E1"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
